// *** THIS PACKAGE HAS SPECIAL LICENSING CONDITIONS.  PLEASE
//     CONSULT THE OWNERS AND opensource-licensing@google.com BEFORE
//     DEPENDING ON IT IN YOUR PROJECT. ***
package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_amlogic_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   SPDX-license-identifier-BSD
    //   legacy_by_exception_only (by exception only)
    //   legacy_proprietary (by exception only)
    default_applicable_licenses: ["hardware_amlogic_license"],
}

bootstrap_go_package {
    name: "soong-audio-utils",
    pkgPath: "android/soong/hardware/amlogic/audio/utils",
    deps: [
        "blueprint",
        "blueprint-pathtools",
        "soong",
        "soong-android",
        "soong-cc",
        "soong-genrule",
    ],
    srcs: [
        "audio_utils_default.go",
    ],
    pluginFor: ["soong_build"],
}

audio_utils_go_defaults {
    name: "audio_utils_go_defaults",
}


// In order to reduce audiohal mlock memory size, remove some bootup code out of libamaudioutils.so
cc_library_shared {
    name: "libamaudioutils_boot",
    vendor: true,
    defaults: ["audio_utils_go_defaults"],
    compile_multilib: "both",
    header_libs: [
        "libaudioclient_headers",
        "libaudio_system_headers",
        "libbinder_headers",
        "libhardware_headers",
        "libutils_headers",
        "libamaudioutils_headers",
        "libamaudioutils_boot_headers",
    ],

    srcs: [
        "aml_configs/aml_conf_loader.c",
        "aml_configs/aml_conf_parser.c",
        "ini/ini.cpp",
        "ini/IniParser.cpp",
        "cJSON/cJSON.c",
        "aml_mlock_library.c",
        "aml_malloc_debug.c",
    ],

    shared_libs: [
        "libc",
        "libcutils",
        "libutils",
        "liblog",
    ],

    local_include_dirs: [
        "include",
        "cJSON",
    ],

    cflags: [
        "-DBUILD_IN_ANDROID",
        "-Wno-error",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-unused-function",
    ],
}

cc_library_headers {
    name: "libamaudioutils_boot_headers",
    vendor: true,
    proprietary: true,

    export_include_dirs: [
        "ini/include",
        "cJSON",
    ],
}

cc_library_shared {
    name: "libamaudioutils",
    vendor: true,
    defaults: ["audio_utils_go_defaults"],
    compile_multilib: "both",
    header_libs: [
        "libaudioclient_headers",
        "libaudio_system_headers",
        "libbinder_headers",
        "libhardware_headers",
        "libutils_headers",
        "libamaudioutils_headers",
        "libamaudioutils_boot_headers",
    ],

    srcs: [
        "aml_async_write.c",
        "alsa_device_parser.c",
        "audio_data_process.c",
        "aml_alsa_mixer.c",
        "aml_android_hidl_utils.cpp",
        "aml_android_utils.c",
        "aml_audio_spdifdec.c",
        "aml_buffer_provider.c",
        "aml_data_utils.c",
        "aml_dump_debug.c",
        "aml_echo_reference.c",
        "aml_hw_mixer.c",
        "aml_ringbuffer.c",
        "aml_volume_utils.c",
        "spdifenc_wrap.cpp",
        "SPDIFEncoderAD.cpp",
        "aml_effects_util.cpp",
        "aml_audio_report.c",
        "aml_audio_sysfs.c",
        "aml_vad_wakeup.cpp",
        "aml_peq.c",
        "aml_reverb.c",
        "aml_audio_uevent.c",
    ],

    shared_libs: [
        "libc",
        "libcutils",
        "libutils",
        "liblog",
        "libtinyalsa",
        "libaudioutils",
        "libdroidaudiospdif",
        "android.hardware.audio.common-util",
        "libamaudioutils_boot"
    ],

    cflags: [
        "-DBUILD_IN_ANDROID",
        "-Wno-error",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-unused-function",
    ],
}

cc_library_headers {
    name: "libamaudioutils_headers",
    vendor: true,
    proprietary: true,

    export_include_dirs: [
        "include",
        "parser/include",
    ],
}

//###################################
//Conversion of IEC61937 to raw audio
//###################################
cc_binary {

    name: "spdif_decoder",

    vendor: true,
compile_multilib: "32",
    srcs: [
        "aml_audio_spdifdec.c",
        "spdifdec_test.c",
    ],

    shared_libs: [
        "libamaudioutils",
        "libcutils",
        "liblog",
        "libamaudioutils_boot",
    ],

    header_libs: [
        "libaudio_system_headers",
    ],

    local_include_dirs: [
        "include",
        "parser/include",
    ],
}
